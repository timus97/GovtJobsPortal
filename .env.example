# Collection
# Per-source PDF cap defaults to 10. Unset PDF_MAX_PER_RUN defaults to 200.
# The scheduled workflow sets 25.
PDF_MAX_PER_RUN=25

# Email alerts (daily new jobs). ALERT_ENABLED must be exactly true.
ALERT_ENABLED=false
ALERT_ON_FIRST_RUN=false
ALERT_TO=you@example.com
# Student password reset — Resend free tier (recommended, 100 emails/day).
# Create a key at https://resend.com/api-keys (no credit card).
# Default from-address (beth.v@example.com) can only mail the Resend
# account owner until you verify a domain, then set MAIL_FROM.
RESEND_API_KEY=
MAIL_FROM="Sarkari Desk <onboarding@resend.dev>"

# Fallback SMTP (Gmail app password, Brevo, etc.) if Resend is unset.
# The daily alert uses these SMTP fields. SMTP_SECURE=true means SSL; otherwise STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sarkari Desk <alerts@example.com>"
PUBLIC_SITE_URL=http://localhost:8090
# Without Resend or SMTP, local (non-production) reset returns a one-time devResetUrl.

# Student desk. Postgres is the store. Flyway owns the schema.
# start-web.ps1 sets STUDENT_DATABASE_URL to the jdbc URL.
# STUDENT_DATABASE_URL=postgres://govtjobs:govtjobs@127.0.0.1:5432/govtjobs_students
# STUDENT_FILES_DIR=data/student-files
# Admit/result bytes stay on disk. Never put student rows in git or portal.sqlite.

# Ops + student sessions. Required in production.
# SESSION_SECRET=
# OPERATOR_PASSWORD=
# After a local admin reset, the username and password are in .local/dev-admin.txt (gitignored).
# Paste-URL git ingest. Missing token → published_local. Paste does not start the daily crawl.
# OPS_INGEST_TOKEN=
# GITHUB_REPOSITORY=timus97/GovtJobsPortal
# OPS_INGEST_BRANCH=master
