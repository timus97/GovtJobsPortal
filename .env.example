# Collection
COLLECT_HEADLESS=true
PDF_MAX_PER_RUN=25
# COLLECT_SOURCE=becil

# Email alerts (daily new jobs)
ALERT_ENABLED=false
ALERT_ON_FIRST_RUN=false
ALERT_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NoExam Sarkari <alerts@example.com>"
PUBLIC_SITE_URL=http://localhost:5173

# Optional Express SQLite read cache (server-only, rebuilt from git JSON on boot).
# Catalog-only. JSON remains the catalog SoR. Never student tables.
# Not used by GitHub Actions / Pages.
# SQLITE_CACHE=on
# SQLITE_PATH=data/cache/portal.sqlite

# Student desk (Stage 7). Host JSON + files, never git / Pages / portal.sqlite.
# Production needs a persistent disk. Render free sleep/redeploy wipes local dirs.
# FEATURE_STUDENT=on
# VITE_FEATURE_STUDENT=on
# Off on GitHub Pages unless VITE_API_BASE points at the API host.
# STUDENT_DATA_DIR=data/students
# STUDENT_FILES_DIR=data/student-files
# On a host disk: STUDENT_DATA_DIR=/var/data/students
#                 STUDENT_FILES_DIR=/var/data/student-files

# Ops + student sessions (PR07 / Stage 7). Required in production.
# SESSION_SECRET=
# OPERATOR_PASSWORD=
# Paste-URL git ingest. Missing token → published_local. Never dispatch pipeline:daily.
# OPS_INGEST_TOKEN=
# GITHUB_REPOSITORY=timus97/GovtJobsPortal
# OPS_INGEST_BRANCH=master
